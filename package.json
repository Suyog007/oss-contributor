{
  "name": "oss-contributor",
  "version": "0.1.0",
  "private": true,
  "description": "Autonomous open-source contribution agent: discovery, evidence-based issue validation, implementation, independent review, and gated PR submission.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.5.1",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "local": "bash scripts/local.sh",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:live": "vitest run tests/live",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "worker": "tsx src/worker/main.ts",
    "discover": "tsx scripts/discover.ts",
    "hypotheses": "tsx scripts/hypotheses.ts",
    "investigate": "tsx scripts/investigate.ts",
    "implement": "tsx scripts/implement.ts",
    "review": "tsx scripts/review.ts",
    "submit": "tsx scripts/submit.ts",
    "publish": "tsx scripts/publish.ts",
    "rebuild-digest": "tsx scripts/rebuild-digest.ts",
    "sandbox-check": "tsx scripts/sandbox-check.ts",
    "inspect-repo": "tsx scripts/inspect-repo.ts",
    "advance": "tsx scripts/advance.ts",
    "status": "tsx scripts/status.ts",
    "approve": "tsx scripts/approve.ts",
    "budget": "tsx scripts/budget.ts",
    "doctor": "tsx scripts/doctor.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "dotenv": "^18.0.7",
    "next": "^16.4.0",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prettier": "^3.9.9",
    "prisma": "7.10.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
