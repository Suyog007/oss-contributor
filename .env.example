# ---------------------------------------------------------------------------
# Database (required)
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://oss_contributor:oss_contributor@localhost:5432/oss_contributor"
# Integration tests truncate tables in this database.
TEST_DATABASE_URL="postgresql://oss_contributor:oss_contributor@localhost:5432/oss_contributor_test"

# ---------------------------------------------------------------------------
# Fireworks AI (server-side only, never exposed to the browser or to sandboxes)
# ---------------------------------------------------------------------------
FIREWORKS_API_KEY=""
FIREWORKS_BASE_URL="https://api.fireworks.ai/inference/v1"
# Cheap/fast model for extraction-style work. Must be an OpenAI-compatible chat model.
FIREWORKS_MODEL_FAST="accounts/fireworks/models/deepseek-v4p1-flash"
# Stronger model for hypothesis generation, solution planning, and adversarial review.
FIREWORKS_MODEL_DEEP="accounts/fireworks/models/kimi-k3"

# Master switch. When false, no model request is ever sent.
AI_ENABLED="true"
# Plan calls and report estimated cost without sending anything.
AI_DRY_RUN="false"

# Budgets (USD). Spend counters live in the database, so they survive restarts.
AI_DAILY_BUDGET_USD="5"
AI_MONTHLY_BUDGET_USD="60"
# Hard cap for a single contribution, implementation and review included.
AI_CONTRIBUTION_BUDGET_USD="2"
# Hard cap for investigating a single candidate issue.
AI_CANDIDATE_BUDGET_USD="0.75"
AI_BUDGET_TIMEZONE="UTC"

AI_MAX_OUTPUT_TOKENS="12000"
AI_MAX_RETRIES="2"
AI_REQUEST_TIMEOUT_MS="240000"
# Identical prompts are answered from the database cache for this long.
AI_CACHE_TTL_HOURS="168"
# Reasoning effort. Empty means: 'low' for the cheap tier, AI_REASONING_EFFORT_DEEP for the deep tier.
# Reasoning tokens are billed as output, so this is a real cost lever.
AI_REASONING_EFFORT=""
AI_REASONING_EFFORT_DEEP="medium"
# JSON object mapping model id -> {inputPerMTok, outputPerMTok, cachedInputPerMTok}
# Use it when Fireworks pricing changes without waiting for a release.
AI_PRICING_OVERRIDES=""

# ---------------------------------------------------------------------------
# GitHub
# ---------------------------------------------------------------------------
# Classic or fine-grained token with `repo` scope (public repos are enough for
# read-only operation, `repo`/`public_repo` is required to push branches).
GITHUB_TOKEN=""
# REST base URL. Change only for GitHub Enterprise.
GITHUB_API_URL="https://api.github.com"
GITHUB_GRAPHQL_URL="https://api.github.com/graphql"
# Account that owns the fork we push to. Defaults to the token's own login.
GITHUB_FORK_OWNER=""

# ---------------------------------------------------------------------------
# Discovery
# ---------------------------------------------------------------------------
# Comma-separated GitHub search queries. Anything valid for GitHub's code/repo
# search works; the built-in packs below cover emerging and established projects.
DISCOVERY_QUERY_PACKS="emerging,established"
DISCOVERY_MAX_QUERIES_PER_RUN="12"
DISCOVERY_RESULTS_PER_QUERY="40"
DISCOVERY_MIN_STARS="60"
# Hard gates applied before any model call.
DISCOVERY_MAX_REPO_SIZE_KB="250000"
DISCOVERY_MAX_DAYS_SINCE_PUSH="120"
DISCOVERY_REQUIRE_LICENSE="true"
DISCOVERY_REQUIRE_TESTS="false"
# Repositories younger than this are rejected: early attention is not evidence.
DISCOVERY_MIN_REPO_AGE_DAYS="14"
# How many repositories per run get the expensive per-repo activity calls.
DISCOVERY_MAX_PROJECTS_PER_RUN="20"
# How many projects are sent to analysis (and therefore to the model) per run.
DISCOVERY_MAX_ANALYSES_PER_RUN="4"
# Known projects refreshed each run so growth can be measured over time.
DISCOVERY_TRACK_EXISTING_PER_RUN="10"
# Minimum deterministic discovery score required before paying for analysis.
DISCOVERY_MIN_SCORE_TO_ANALYZE="35"

# ---------------------------------------------------------------------------
# Analysis and investigation limits
# ---------------------------------------------------------------------------
# Maximum bytes of file content sent to a model for repository analysis.
ANALYSIS_MAX_CONTEXT_BYTES="120000"
# A repository at or above this size is analyzed by targeted file selection only.
ANALYSIS_LARGE_REPO_KB="150000"
CANDIDATE_MAX_PER_PROJECT="3"
CANDIDATE_MIN_CONFIDENCE="0.6"
# Reproduction attempts per candidate before giving up.
REPRO_MAX_ATTEMPTS="2"

# ---------------------------------------------------------------------------
# Implementation, review, and submission
# ---------------------------------------------------------------------------
WORKSPACE_ROOT=".workspaces"
MAX_REVISION_ROUNDS="3"
MAX_REVIEWERS_PER_ROUND="4"
# Wall-clock ceilings.
TASK_TIMEOUT_MS="1800000"
SANDBOX_TIMEOUT_MS="900000"

# Sandbox: docker (isolated container), local_restricted (no network, limited
# commands, host process), or none (no execution at all).
SANDBOX_MODE="docker"
SANDBOX_IMAGE="node:22-bookworm"
SANDBOX_MEMORY_MB="2048"
SANDBOX_CPUS="2"
SANDBOX_PIDS_LIMIT="512"
SANDBOX_DISK_MB="4096"
# Repository code never gets network access by default. Package installs that
# need the network require SANDBOX_ALLOW_NETWORK=true and an operator decision.
SANDBOX_ALLOW_NETWORK="false"
SANDBOX_ALLOWED_IMAGE_PREFIXES="node:,python:,ubuntu:,debian:,golang:,rust:,maven:,eclipse-temurin:,alpine:,ruby:,php:,mcr.microsoft.com/dotnet:,hexpm/elixir:"
# Only these repositories may execute outside a container (local_restricted mode).
# Never list a repository you do not trust: this mode is not a security boundary.
SANDBOX_LOCAL_TRUSTED_PROJECTS=""

# Commit identity. Leave the name empty to use the agent's own identity.
GIT_AUTHOR_NAME=""
GIT_AUTHOR_EMAIL=""

# Autonomy. Defaults keep every externally visible action behind human approval.
AUTONOMY_LEVEL="approval_required"
AUTONOMY_ALLOWED_ACTIONS=""
APPROVAL_TTL_HOURS="72"

# ---------------------------------------------------------------------------
# Worker
# ---------------------------------------------------------------------------
WORKER_ID=""
WORKER_CONCURRENCY="1"
WORKER_POLL_MS="2000"
WORKER_TASK_MAX_MS="1800000"
WORKER_LEASE_MS="2400000"

# ---------------------------------------------------------------------------
# Dashboard
# ---------------------------------------------------------------------------
DASHBOARD_AUTH_DISABLED="false"
DASHBOARD_PASSWORD=""
SESSION_SECRET=""

# Whole-file edit calls can take longer than a normal agent call.
AI_LONG_REQUEST_TIMEOUT_MS="600000"
